# Configuración de Conexión a Base de Datos - Plantilla de Entorno
# Copia este archivo a .env en la raíz del proyecto y completa con las credenciales reales.
# NUNCA subas el archivo .env con contraseñas a GitHub.

# Tipo de Base de Datos: postgresql | mssql | mysql | oracle
DB_TYPE=mssql

# Servidor / Host
DB_HOST=localhost

# Puerto por defecto (MSSQL: 1433, PostgreSQL: 5432, MySQL: 3306)
DB_PORT=1433

# Nombre de la Base de Datos
DB_NAME=Promigas_Gestion_Diaria

# Credenciales de Acceso
DB_USER=usuario_analista
DB_PASSWORD=tu_password_aqui

# Driver ODBC específico (solo si aplica para SQL Server o similar)
# Ejemplos: "ODBC Driver 17 for SQL Server", "ODBC Driver 18 for SQL Server"
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
