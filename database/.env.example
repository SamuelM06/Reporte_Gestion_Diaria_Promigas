# ==============================================================================
# PLANTILLA de configuración de base de datos — PROYECTO GESTIÓN DIARIA PROMIGAS
# ==============================================================================
# CÓMO USAR:
#   1. Copia este archivo como ".env" (sin renombrar la extensión a otro formato).
#        En Windows:  copy .env.example .env
#        En Linux/mac: cp .env.example .env
#   2. Completa los valores de abajo con las credenciales que te entregue el
#      administrador de la base de datos.
#   3. Verifica la conexión:  python database/conexion_template.py
#
# IMPORTANTE:
#   - El archivo ".env" contiene contraseñas. Está en el .gitignore del
#     repositorio: NUNCA lo subas a GitHub ni lo compartas por correo/chat.
#   - Este archivo (.env.example) SÍ se versiona: solo contiene la plantilla,
#     nunca valores reales de host, usuario ni contraseña.
#   - Si necesitas documentar el entorno de conexión, usa placeholders como
#     <host> o <usuario>, no valores reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# Tipo de motor de base de datos
# Valores permitidos: postgresql | mssql | mysql | oracle
# ------------------------------------------------------------------------------
DB_TYPE=postgresql

# ------------------------------------------------------------------------------
# Servidor / Host
# ------------------------------------------------------------------------------
DB_HOST=<host>

# ------------------------------------------------------------------------------
# Puerto
# Por defecto: MSSQL 1433 | PostgreSQL 5432 | MySQL 3306 | Oracle 1521
# ------------------------------------------------------------------------------
DB_PORT=5432

# ------------------------------------------------------------------------------
# Nombre de la base de datos
# ------------------------------------------------------------------------------
DB_NAME=<nombre_base_datos>

# ------------------------------------------------------------------------------
# Esquema de trabajo (dónde viven las tablas del proyecto)
# ------------------------------------------------------------------------------
DB_SCHEMA=gestion_diaria

# ------------------------------------------------------------------------------
# Credenciales de acceso
# ------------------------------------------------------------------------------
DB_USER=<usuario>
DB_PASSWORD=<password>

# ------------------------------------------------------------------------------
# Driver ODBC — solo aplica a SQL Server (mssql). Ignorar en otros motores.
# Ejemplos: "ODBC Driver 17 for SQL Server", "ODBC Driver 18 for SQL Server"
# ------------------------------------------------------------------------------
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
